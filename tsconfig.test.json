{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/globals.d.ts",
    "e2e/**/*.ts",
    "bundled-service/src/**/*.test.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
